#!/usr/bin/env bash
set -euo pipefail

# Pre-commit: refresh anatomy/wiki for staged source changes.
# Skip with `git commit --no-verify` when needed.

if ! command -v claude >/dev/null 2>&1; then
  echo "pre-commit: claude CLI not found, skipping anatomy refresh" >&2
  exit 0
fi

STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|mjs)$' || true)
if [ -z "$STAGED" ]; then
  exit 0
fi

# Refresh the anatomy/wiki for any tracked staged files. /anatomy refresh is
# an incremental run that updates only the touched area pages.
TRACKED=$(echo "$STAGED" | grep -E '^(apps|packages)/' || true)
if [ -n "$TRACKED" ]; then
  echo "pre-commit: refreshing anatomy/wiki for tracked files..." >&2
  REFRESH="/anatomy refresh $(echo "$TRACKED" | tr '\n' ' ')"
  claude -p "$REFRESH" --output-format text || {
    echo "pre-commit: /anatomy refresh failed (continuing commit)" >&2
  }
  # Stage the wiki updates so they land in this commit.
  git add ANATOMY.md docs/wiki/ 2>/dev/null || true
fi
