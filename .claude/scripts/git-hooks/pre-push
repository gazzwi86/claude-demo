#!/usr/bin/env bash
set -euo pipefail

# Pre-push: run /review (advisory) then /security-review (blocking) on pending branch changes.
# Blocks the push on security findings (exit non-zero). Skip with `git push --no-verify`.

PROJECT_ROOT=$(git rev-parse --show-toplevel)
if ! python3 "$PROJECT_ROOT/.claude/scripts/hooks.py" check-anatomy-fresh; then
  echo "pre-push: anatomy is stale; commit a refresh first (or --no-verify to bypass)" >&2
  exit 1
fi

if ! command -v claude >/dev/null 2>&1; then
  echo "pre-push: claude CLI not found, skipping /review and /security-review" >&2
  exit 0
fi

UPSTREAM_REF=""
if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
  UPSTREAM_REF=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}')
fi

if [ -n "$UPSTREAM_REF" ]; then
  RANGE="$UPSTREAM_REF..HEAD"
else
  # No upstream yet (first push). Fall back to diff against main.
  RANGE="main..HEAD"
fi

if [ -z "$(git log "$RANGE" --oneline 2>/dev/null || true)" ]; then
  exit 0
fi

# [advisory] /review pass — output shown but does not block the push.
echo "pre-push: [advisory] running /review on $RANGE ..." >&2
REVIEW_PROMPT="/review Review changes in range $RANGE. Summarise quality, correctness, and maintainability concerns."
claude -p "$REVIEW_PROMPT" --output-format text 2>&1 || true

# [blocking] /security-review pass — blocks on findings.
echo "pre-push: [blocking] running /security-review on $RANGE ..." >&2
PROMPT="/security-review Review changes in range $RANGE. Output JSON: {\"findings\":[...],\"block\":true|false}. Block on credentials, eval/Function, SQL injection, command injection."
RESULT=$(claude -p "$PROMPT" --output-format text 2>&1) || {
  echo "$RESULT" >&2
  echo "pre-push: /security-review failed; use --no-verify to bypass" >&2
  exit 1
}

# If the model was asked for JSON and produced "block":true, fail.
if echo "$RESULT" | grep -qE '"block"[[:space:]]*:[[:space:]]*true'; then
  echo "$RESULT" >&2
  echo "pre-push: [blocking] push blocked due to security findings (use --no-verify to bypass)" >&2
  exit 1
fi

echo "pre-push: /security-review passed" >&2
