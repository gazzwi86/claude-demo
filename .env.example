# Copy to .env and fill in. The .env is gitignored.

# --- Auth ---
# JWT signing secret — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# --- AWS / local stack ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# DynamoDB Local endpoint (docker compose service)
DYNAMODB_ENDPOINT=http://localhost:8000

# LocalStack endpoint (S3 only in dev)
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=looper-loops-dev
S3_FORCE_PATH_STYLE=true

# Table names (override per env)
DDB_USERS_TABLE=looper_users
DDB_LOOPS_TABLE=looper_loops
DDB_SESSIONS_TABLE=looper_sessions

# --- Server ---
API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001

# --- Public (web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
